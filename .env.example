# ---------------------------------------------------------------------------
# W3Tech - environment variable template
# Copy to `.env` (or `.env.local`) and fill in real values. Never commit secrets.
# ---------------------------------------------------------------------------

# --- Form delivery / SMTP (src/lib/email.ts) -------------------------------
# This project stores nothing: contact and career submissions are delivered
# by email only, so HOST/USER/PASS are required for the forms to work.
# Port 465 connects with implicit TLS; 587 uses STARTTLS.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=W3Tech Website
SMTP_FROM_EMAIL=

# Inbox that receives form submissions. Falls back to SMTP_FROM_EMAIL.
CONTACT_RECIPIENT_EMAIL=

# --- Analytics (src/lib/analytics.ts, AnalyticsInit.tsx) -------------------
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Blank disables it.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
